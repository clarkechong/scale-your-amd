digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.10, nodesep=0.35, ranksep=0.52, label="BF16 MaxText linear: ordinary HLO dot", labelloc="t", fontsize=14, fontname="Helvetica", fontcolor="#27313b"];
  edge [color="#8a959e", penwidth=1.1, arrowsize=0.7, fontname="Helvetica", fontsize=8, fontcolor="#65717d"];
  master [label="master weight\nf32[256,256]", shape=box, style="rounded,filled", fillcolor="#dff0e4", color="#4e8a5c", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  cast [label="convert_element_type.1\nbf16[256,256]", shape=box, style="rounded,filled", fillcolor="#f5f7f8", color="#8a959e", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  activation [label="activation\nbf16[128,256]", shape=box, style="rounded,filled", fillcolor="#dce9f5", color="#3f76ab", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  dot [label="dot_general.1\ndot, contract K=256\nbf16[128,256]", shape=box, style="rounded,filled", fillcolor="#dce9f5", color="#3f76ab", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  master -> cast;
  cast -> dot [label="rhs"];
  activation -> dot [label="lhs"];
}
