digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.10, nodesep=0.35, ranksep=0.52, label="FP8 delayed scaling: typed FFI quantize and GEMM calls", labelloc="t", fontsize=14, fontname="Helvetica", fontcolor="#27313b"];
  edge [color="#8a959e", penwidth=1.1, arrowsize=0.7, fontname="Helvetica", fontsize=8, fontcolor="#65717d"];
  activation [label="activation\nbf16[128,256]", shape=box, style="rounded,filled", fillcolor="#dce9f5", color="#3f76ab", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  xstate [label="delayed x scale\nf32\nhistory updated separately", shape=box, style="rounded,filled", fillcolor="#e9e3f2", color="#6d5b9e", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  quantx [label="te_dbias_quantize_ffi.16\nte_dbias_quantize_ffi\nf8e4m3fn[128,256] + f32 scale", shape=box, style="rounded,filled", fillcolor="#f7e6c8", color="#b0842f", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  master [label="master weight\nf32[256,256]", shape=box, style="rounded,filled", fillcolor="#dff0e4", color="#4e8a5c", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  cast [label="compute weight\nbf16[256,256]", shape=box, style="rounded,filled", fillcolor="#f5f7f8", color="#8a959e", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  wstate [label="delayed weight scale\nf32\nhistory updated separately", shape=box, style="rounded,filled", fillcolor="#e9e3f2", color="#6d5b9e", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  quantw [label="te_dbias_quantize_ffi.24\nte_dbias_quantize_ffi\nf8e4m3fn[256,256] + f32 scale", shape=box, style="rounded,filled", fillcolor="#f7e6c8", color="#b0842f", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  gemm [label="te_gemm_v2_ffi.3\nte_gemm_v2_ffi\nper-tensor scaled FP8\n→ bf16[128,256]", shape=box, style="rounded,filled", fillcolor="#e9e3f2", color="#6d5b9e", fontcolor="#27313b", fontname="Helvetica", fontsize=10, margin="0.12,0.08"];
  activation -> quantx;
  xstate -> quantx [style=dashed];
  master -> cast;
  cast -> quantw;
  wstate -> quantw [style=dashed];
  quantx -> gemm [label="FP8 + scale"];
  quantw -> gemm [label="FP8 + scale"];
}
