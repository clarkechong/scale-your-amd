{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarkechong.github.io/scale-your-amd/artifacts/schema.json",
  "title": "MI355X case-study artifact manifest",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "run_id",
    "evidence_label",
    "claim_ids",
    "bundle_status",
    "run_outcome",
    "started_at_utc",
    "hardware",
    "software",
    "workload",
    "launch",
    "mesh",
    "protocol",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_label": {
      "const": "measured"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bundle_status": {
      "enum": [
        "complete",
        "blocked"
      ]
    },
    "run_outcome": {
      "enum": [
        "pass",
        "fail",
        "aborted",
        "not_run"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "hardware": {
      "type": "object",
      "required": [
        "accelerator",
        "architecture",
        "nodes",
        "devices_per_node",
        "compute_partition",
        "memory_partition",
        "device_inventory_file",
        "topology_file"
      ],
      "properties": {
        "accelerator": {
          "const": "MI355X"
        },
        "architecture": {
          "const": "gfx950"
        },
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "devices_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "compute_partition": {
          "type": "string"
        },
        "memory_partition": {
          "type": "string"
        },
        "device_inventory_file": {
          "$ref": "#/$defs/path"
        },
        "topology_file": {
          "$ref": "#/$defs/path"
        },
        "network_file": {
          "$ref": "#/$defs/nullablePath"
        },
        "rail_map_file": {
          "$ref": "#/$defs/nullablePath"
        },
        "rank_affinity_file": {
          "$ref": "#/$defs/nullablePath"
        }
      },
      "additionalProperties": true
    },
    "software": {
      "type": "object",
      "required": [
        "container",
        "container_digest",
        "rocm",
        "python",
        "jax",
        "jaxlib",
        "pjrt_plugin",
        "rccl",
        "repositories"
      ],
      "properties": {
        "container": {
          "type": "string"
        },
        "container_digest": {
          "type": "string",
          "minLength": 1
        },
        "rocm": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "jax": {
          "type": "string"
        },
        "jaxlib": {
          "type": "string"
        },
        "pjrt_plugin": {
          "type": "string"
        },
        "rccl": {
          "type": "string"
        },
        "xprof": {
          "type": [
            "string",
            "null"
          ]
        },
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/repository"
          }
        }
      },
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": [
        "model_name",
        "model_config_hash",
        "precision_recipe",
        "sequence_length",
        "per_device_batch_size",
        "global_sequences_per_step",
        "global_nonpadding_tokens_per_step",
        "gradient_accumulation_steps",
        "steps",
        "dataset_kind"
      ],
      "properties": {
        "model_name": {
          "type": "string"
        },
        "model_config_hash": {
          "type": "string"
        },
        "precision_recipe": {
          "type": "string"
        },
        "sequence_length": {
          "type": "integer",
          "minimum": 1
        },
        "per_device_batch_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "global_sequences_per_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "global_nonpadding_tokens_per_step": {
          "type": "integer",
          "minimum": 0
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "dataset_kind": {
          "enum": [
            "synthetic",
            "manifest"
          ]
        },
        "dataset_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokenizer_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "launch": {
      "type": "object",
      "required": [
        "command_file",
        "environment_file",
        "xla_flags_file",
        "process_count",
        "device_visibility"
      ],
      "properties": {
        "command_file": {
          "$ref": "#/$defs/path"
        },
        "environment_file": {
          "$ref": "#/$defs/path"
        },
        "xla_flags_file": {
          "$ref": "#/$defs/path"
        },
        "process_count": {
          "type": "integer",
          "minimum": 1
        },
        "device_visibility": {
          "type": "string"
        },
        "initialization_timeout": {
          "type": [
            "number",
            "null"
          ]
        },
        "heartbeat_timeout_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "shutdown_timeout_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "coordinator_bind_address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "mesh": {
      "type": "object",
      "required": [
        "ici",
        "dcn",
        "logical_axis_rules_hash"
      ],
      "properties": {
        "ici": {
          "type": "object"
        },
        "dcn": {
          "type": "object"
        },
        "logical_axis_rules_hash": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "object",
      "required": [
        "warmup_steps",
        "measured_steps",
        "synchronization",
        "statistic",
        "timing_profiled",
        "cache_policy",
        "clock_policy"
      ],
      "properties": {
        "warmup_steps": {
          "type": "integer",
          "minimum": 0
        },
        "measured_steps": {
          "type": "integer",
          "minimum": 1
        },
        "synchronization": {
          "type": "string"
        },
        "statistic": {
          "const": "median"
        },
        "timing_profiled": {
          "const": false
        },
        "cache_policy": {
          "type": "string"
        },
        "clock_policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ledgers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nullablePath"
      }
    },
    "series": {
      "type": "object",
      "properties": {
        "series_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "point_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fixed_contract_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nullablePath"
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nullablePath"
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "checksum_file",
        "omissions"
      ],
      "properties": {
        "checksum_file": {
          "$ref": "#/$defs/path"
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "nullablePath": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "diff_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
